# Copy to .env for local runs. In CI these are GitHub Actions repository secrets.
# NEVER commit the real .env or the service-account JSON.

# --- Reddit API (reddit.com/prefs/apps -> create a "script" app) ---
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=joke-factory/1.0 by u/your_reddit_username

# --- Google Sheets ---
# The spreadsheet ID from its URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=your_sheet_id
# Path to the service-account JSON key (local runs).
# In CI, the JSON content is provided via GOOGLE_SA_JSON instead.
GOOGLE_SA_JSON_PATH=service-account.json
# CI only: full JSON content of the service-account key (leave empty locally).
GOOGLE_SA_JSON=

# --- Groq (console.groq.com -> API Keys, free tier) ---
GROQ_API_KEY=your_groq_api_key
